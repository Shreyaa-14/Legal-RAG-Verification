{"act_id": "IND_state_19002", "chunk_id": "IND_state_19002_s001", "title": "The Andaman and Nicobar Islands Prevention of Defacement of Property Regulation 1987", "chapter": "", "section_number": "1", "section_title": "The Andaman and Nicobar Islands Prevention of Defacement of Property Regulation 1987", "text": "Act: The Andaman and Nicobar Islands Prevention of Defacement of Property Regulation 1987 (Act 1 of 1987) | India | State | In Force\nSection 1: Short Titles, Extent and Commencement\n\n1. Short Titles, Extent and Commencement\n(1) This Regulation may be called the Andaman and Nicobar Islands\nPrevention of Defacement of Property Regulation, 1987.\n\n1\n(2) It extends to the whole of the Union territory of the Andaman and\nNicobar Islands.\n\n1\n(3) It shall come into force at once,\n\n1", "jurisdiction": "state", "state": "andaman-nicobar", "instrument_type": "legislation", "act_status": "in_force", "in_force": true, "doc_type": "legislation", "provision_type": "mandatory", "section_type": "short_title", "legal_subject": "['property_law']", "has_proviso": false, "has_non_obstante": false, "delegation_type": null, "department": "", "regulatory_body": null, "acts_referenced": [], "defined_terms": [], "amendment_count": 0, "year": 1987.0, "source_url": "https://www.indiacode.nic.in/handle/123456789/19002?view_type=browse", "language_code": "en", "source_publisher": "Legislative Department, Ministry of Law and Justice (India Code)", "mirror_url": "https://oss-data-in.vaquill.ai/legislation/IND_state_19002/act.pdf"}
