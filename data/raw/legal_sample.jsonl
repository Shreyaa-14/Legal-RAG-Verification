{"act_id": "IND_state_19320", "chunk_id": "IND_state_19320_s38G", "title": "The Wildlife (Protection) Act, 1972", "chapter": "IV", "section_number": "38G", "section_title": "The Wildlife (Protection) Act, 1972", "text": "Act: The Wildlife (Protection) Act, 1972 (Act 53 of 1972) | India | State | In Force\nChapter IV: ** | Section 38G: Annual report and audit report to be laid before Parliament.** - The Central Government shall cause\n\n**38G. Annual report and audit report to be laid before Parliament.** - The Central Government shall cause the annual report together with a memorandum of action taken on the recommendations contained therein, in so far as they relate to the Central Government, and the reasons for the non-acceptance, if any, of any of such recommendations and the audit report to be laid as soon as may be after the reports are received before each House of Parliament.", "jurisdiction": "state", "state": "andaman-nicobar", "instrument_type": "legislation", "act_status": "in_force", "in_force": true, "doc_type": "legislation", "provision_type": "mandatory", "section_type": "section", "legal_subject": "['environmental_law']", "has_proviso": false, "has_non_obstante": false, "delegation_type": null, "department": "", "regulatory_body": null, "acts_referenced": [], "defined_terms": [], "amendment_count": 0, "year": 1972.0, "source_url": "https://www.indiacode.nic.in/handle/123456789/19320?view_type=browse", "language_code": "en", "source_publisher": "Legislative Department, Ministry of Law and Justice (India Code)", "mirror_url": "https://oss-data-in.vaquill.ai/legislation/IND_state_19320/act.pdf"}
