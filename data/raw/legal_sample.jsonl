{"act_id": "IND_state_19025", "chunk_id": "IND_state_19025_s011_2", "title": "The mimimum wates act, 1948", "chapter": "", "section_number": "11", "section_title": "The mimimum wates act, 1948", "text": "Act: The mimimum wates act, 1948 (Act 11 of 1948) | India | State | In Force\nSection 11(2): Wages in kind\n\n(2) Where it has been the custom to pay wages wholly or partly in kind, the appropriate Government being of the opinion that it is necessary in the circumstances of the case may, by notification in the Official Gazette, authorize the payment of minimum wages either wholly or partly in kind.", "jurisdiction": "state", "state": "andaman-nicobar", "instrument_type": "legislation", "act_status": "in_force", "in_force": true, "doc_type": "legislation", "provision_type": "mandatory", "section_type": "sub_section", "legal_subject": "['general']", "has_proviso": false, "has_non_obstante": false, "delegation_type": null, "department": "", "regulatory_body": null, "acts_referenced": ["Wages Act, 1936"], "defined_terms": [], "amendment_count": 0, "year": 1948.0, "source_url": "https://www.indiacode.nic.in/handle/123456789/19025?view_type=browse", "language_code": "en", "source_publisher": "Legislative Department, Ministry of Law and Justice (India Code)", "mirror_url": "https://oss-data-in.vaquill.ai/legislation/IND_state_19025/act.pdf"}
{"act_id": "IND_state_19318", "chunk_id": "IND_state_19318_s168_3", "title": "The Motor Vehicle Act, 1939", "chapter": "XII", "section_number": "168", "section_title": "The Motor Vehicle Act, 1939", "text": "Act: The Motor Vehicle Act, 1939 (Act 4 of 1939) | India | State | In Force\nChapter XII: ** | Section 168(3): Award of the Claims Tribunal.** - (1) On receipt of an application for compensation made under secti\n\n(3) When an award is made under this section, the person who is required to pay any amount in terms of such award shall, within thirty days of the date of announcing the award by the Claims Tribunal, deposit the entire amount awarded in such manner as the Claims Tribunal may direct.\n\n_**Corresponding Law.**_ - Section 168 corresponds to section 110-B of the Motor Vehicles Act, 1939.\n\n_**Objects and Reasons.**_ - Clause 168 provides that the Claims Tribunal shall deliver the copies of the award to the parties within fifteen days of the award and that the person against whom the award is made shall deposit the amount awarded within thirty days of announcement of the award.", "jurisdiction": "state", "state": "andaman-nicobar", "instrument_type": "legislation", "act_status": "in_force", "in_force": true, "doc_type": "legislation", "provision_type": "mandatory", "section_type": "sub_section", "legal_subject": "['general']", "has_proviso": true, "has_non_obstante": false, "delegation_type": null, "department": "", "regulatory_body": null, "acts_referenced": ["Motor Vehicles Act, 1939"], "defined_terms": [], "amendment_count": 0, "year": 1939.0, "source_url": "https://www.indiacode.nic.in/handle/123456789/19318?view_type=browse", "language_code": "en", "source_publisher": "Legislative Department, Ministry of Law and Justice (India Code)", "mirror_url": "https://oss-data-in.vaquill.ai/legislation/IND_state_19318/act.pdf"}
