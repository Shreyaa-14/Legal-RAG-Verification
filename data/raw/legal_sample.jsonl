{"act_id": "IND_state_18982", "chunk_id": "IND_state_18982_s076_16", "title": "The Andaman and Nicobar Islands Cooperative Socities Regulation 1973", "chapter": "IX", "section_number": "76", "section_title": "The Andaman and Nicobar Islands Cooperative Socities Regulation 1973", "text": "Act: The Andaman and Nicobar Islands Cooperative Socities Regulation 1973 (Act 3 of 1973) | India | State | In Force\nChapter IX: ** | Section 76(16): Procedure in execution of awards etc\n\n(16) It shall be lawful for the Sale Officer to sell the whole or any portion of\n\nimmovable property of a defaulter in discharge of money due;\n\nProvided always that, so far as may be practicable, no larger section or portion of immovable property shall be sold than may be sufficient to discharge the amount due with interest and expenses, if any, of attachment and sale.", "jurisdiction": "state", "state": "andaman-nicobar", "instrument_type": "legislation", "act_status": "in_force", "in_force": true, "doc_type": "legislation", "provision_type": "prohibitory", "section_type": "sub_section", "legal_subject": "['property_law']", "has_proviso": true, "has_non_obstante": false, "delegation_type": null, "department": "", "regulatory_body": null, "acts_referenced": [], "defined_terms": [], "amendment_count": 0, "year": 1973.0, "source_url": "https://www.indiacode.nic.in/handle/123456789/18982?view_type=browse", "language_code": "en", "source_publisher": "Legislative Department, Ministry of Law and Justice (India Code)", "mirror_url": "https://oss-data-in.vaquill.ai/legislation/IND_state_18982/act.pdf"}
