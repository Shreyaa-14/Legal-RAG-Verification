{"act_id": "IND_state_19151", "chunk_id": "IND_state_19151_s001_6", "title": "The constitution of india", "chapter": "IV", "section_number": "1", "section_title": "The constitution of india", "text": "Act: The constitution of india | India | State | In Force\nChapter IV: .—SPECIAL DIRECTIVES | Section 1(6): to entertain and dispose of appeals and petitions from or in respect of any judgment, decree or order of any court within that State shall cease, and all appeals and other proceedings pending before the said authority at such commencement shall be transferred to, and disposed of by, the Supreme Court.\n\n(6) Every special order made by the State Government under the proviso to clause (5) shall be laid, as soon as may be after it is made, before both Houses of the State Legislature.", "jurisdiction": "state", "state": "andaman-nicobar", "instrument_type": "legislation", "act_status": "in_force", "in_force": true, "doc_type": "legislation", "provision_type": "overriding", "section_type": "sub_section", "legal_subject": "['constitutional_law']", "has_proviso": true, "has_non_obstante": true, "delegation_type": null, "department": "", "regulatory_body": null, "acts_referenced": ["Bombay Reorganisation Act, 1960", "Nagaland Act, 1962", "India Act, 1935", "States Reorganisation Act, 1956", "The Indian Independence Act, 1947", "Privy Council Jurisdiction Act, 1949"], "defined_terms": [], "amendment_count": 0, "year": null, "source_url": "https://www.indiacode.nic.in/handle/123456789/19151?view_type=browse", "language_code": "en", "source_publisher": "Legislative Department, Ministry of Law and Justice (India Code)", "mirror_url": "https://oss-data-in.vaquill.ai/legislation/IND_state_19151/act.pdf", "record_id": "421dbafbe83868c32c34", "preprocessing_info": {"source_record_number": 287, "original_text_length": 591, "cleaned_text_length": 591, "transformations": [], "preprocessing_status": "completed"}, "quality_control": {"decision": "quarantined", "audit_flagged": true,