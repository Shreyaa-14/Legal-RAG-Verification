{"act_id": "IND_state_19150", "chunk_id": "IND_state_19150_s013_2_d17", "title": "The constitution of india", "chapter": "", "section_number": "13", "section_title": "The constitution of india", "text": "Act: The constitution of india | India | State | In Force\nSection 13(2): (** 1) All laws in force in the territory of India immediately before the commencement of this Const\n\n(2) The Supreme Court shall have power to issue directions or orders or writs, including writs in the nature of _habeas corpus, mandamus, prohibition, quo warranto_ and _certiorari_ , whichever may be appropriate, for the enforcement of any of the rights conferred by this Part.", "jurisdiction": "state", "state": "andaman-nicobar", "instrument_type": "legislation", "act_status": "in_force", "in_force": true, "doc_type": "legislation", "provision_type": "overriding", "section_type": "sub_section", "legal_subject": "['constitutional_law']", "has_proviso": true, "has_non_obstante": true, "delegation_type": null, "department": "", "regulatory_body": null, "acts_referenced": [], "defined_terms": [], "amendment_count": 0, "year": null, "source_url": "https://www.indiacode.nic.in/handle/123456789/19150?view_type=browse", "language_code": "en", "source_publisher": "Legislative Department, Ministry of Law and Justice (India Code)", "mirror_url": "https://oss-data-in.vaquill.ai/legislation/IND_state_19150/act.pdf", "record_id": "f196e600f9f2237964cf", "preprocessing_info": {"source_record_number": 365, "original_text_length": 453, "cleaned_text_length": 453, "transformations": [], "preprocessing_status": "completed"}, "quality_control": {"decision": "quarantined", "audit_flagged": true, "manual_review_status": "not_reviewed", "review_message": "Review status is 'not_reviewed'."}}
