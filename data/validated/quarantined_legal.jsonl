{"act_id": "IND_state_19024", "chunk_id": "IND_state_19024_s11A", "title": "The maternity benefit act, 1961", "chapter": "", "section_number": "11A", "section_title": "The maternity benefit act, 1961", "text": "Act: The maternity benefit act, 1961 (Act 53 of 1961) | India | State | In Force\nSection 11A: Crèche facility** . **—** ( _1_ ) Every establishment having fifty or more employees shall have the\n\n> 1[ **11A. Crèche facility** . **—** ( _1_ ) Every establishment having fifty or more employees shall have the facility of créche within such distance as may be prescribed, either separately or along with common facilities:\n\nProvided that the employer shall allow four visits a day to the creche by the woman, which shall also include the interval for rest allowed to her.\n\n( _2_ ) Every establishment shall intimate in writing and electronically to every woman at the time of her initial appointment regarding every benefit available under the Act.]", "jurisdiction": "state", "state": "andaman-nicobar", "instrument_type": "legislation", "act_status": "in_force", "in_force": true, "doc_type": "legislation", "provision_type": "mandatory", "section_type": "section", "legal_subject": "['general']", "has_proviso": true, "has_non_obstante": false, "delegation_type": null, "department": "", "regulatory_body": null, "acts_referenced": [], "defined_terms": [], "amendment_count": 0, "year": 1961.0, "source_url": "https://www.indiacode.nic.in/handle/123456789/19024?view_type=browse", "language_code": "en", "source_publisher": "Legislative Department, Ministry of Law and Justice (India Code)", "mirror_url": "https://oss-data-in.vaquill.ai/legislation/IND_state_19024/act.pdf", "record_id": "f4972a008e84f1be3088", "preprocessing_info": {"source_record_number": 247, "original_text_length": 746, "cleaned_text_length": 746, "transformations": [], "preprocessing_status": "completed"}, "quality_control": {"decision": "quarantined", "audit_flagged": true, "manual_review_status": "not_